# Horizonarr settings. Copy to .env and fill in. Any VAR can also be read from a file with VAR_FILE.

# Required: a free Twitch developer app (https://dev.twitch.tv/console) gives IGDB access
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Country for Steam prices (two letters)
COUNTRY=PT
TZ=Europe/Lisbon

# Optional: RetroArr, for "already have / downloading" badges and the Add / Wishlist buttons
RETROARR_URL=http://retroarr:2727
RETROARR_API_KEY=
# ...or point at RetroArr's config/apikey.json instead of pasting the key
# RETROARR_API_KEY_JSON=/retroarr-config/apikey.json
# Optional: lets wishlist entries skip the empty folder RetroArr creates for every new game
# RETROARR_DB=/retroarr-config/retroarr.db
# RETROARR_STEAM_FOLDER=/retroarr-steam

# Optional: Prowlarr, to show whether a release exists on your indexers
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
AVAILABILITY_PER_DAY=150
AVAILABILITY_GAP_SECONDS=60

# Optional: ntfy push notifications (followed games released / available / cheaper, weekly digest)
NTFY_URL=http://ntfy:80
NTFY_TOPIC=horizonarr
# NTFY_TOKEN=
DIGEST_WEEKDAY=0
DIGEST_HOUR=9
REFRESH_HOUR=6
